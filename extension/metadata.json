{
  "icon": "icon.svg",
  "vm": {
    "composefile": "compose.yaml",
    "exposes": { "socket": "k8s-resilience-engine.sock" }
  },
  "host": {
    "binaries": [
      {
        "darwin": [ { "path": "/darwin/resilience-helper" } ],
        "windows": [ { "path": "/windows/resilience-helper.exe" } ],
        "linux": [ { "path": "/linux/resilience-helper" } ]
      }
    ]
  },
  "ui": {
    "dashboard-tab": {
      "title": "Resilience Engine",
      "root": "/ui",
      "src": "index.html",
      "backend": { "socket": "k8s-resilience-engine.sock" }
    }
  }
}
