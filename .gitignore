*.pdf
curr*.txt
status*.txt
pytest*.txt
git_status*.txt
service_output.txt
p1_schema.txt
p2_schema.txt
pdf_*.txt
current_branch.txt

# Ignore massive third-party YAML test payloads
deploy/kubernetes/boutique.yaml

# Generated kind kubeconfig for the Docker setup (cluster credentials)
.kube/
