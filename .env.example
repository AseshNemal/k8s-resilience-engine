# Default local mode — SQLite, no separate database server required.
# The data/ directory and the .db file are created automatically.
DATABASE_URL=sqlite:///./data/resilience.db

# Server / centralized mode — set this instead to use PostgreSQL.
# Requires the optional PostgreSQL driver: pip install -r requirements-postgres.txt
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/resilience_engine

# Docker Compose (docker compose up --build -d) needs no .env file: it stores SQLite data in a
# named volume. See docs/DOCKER.md. Optional override for the workflow component:
# WORKFLOW_JAEGER_ALLOWED_HOSTS=localhost,127.0.0.1,::1,jaeger
