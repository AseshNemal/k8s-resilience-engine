# Default local mode — SQLite, no separate database server required.
# The data/ directory and the .db file are created automatically.
DATABASE_URL=sqlite:///./data/resilience.db

# Server / centralized mode — set this instead to use PostgreSQL.
# Requires the optional PostgreSQL driver: pip install -r requirements-postgres.txt
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/resilience_engine

# Docker Compose (docker compose up --build -d) — see docs/DOCKER.md.
# Copy this file to .env and change the password. Use URL-safe characters only
# (letters, digits, - _ . ~): it is embedded in the PostgreSQL connection URL.
# In Docker the app uses PostgreSQL automatically; DATABASE_URL above applies only
# to running the app directly with uvicorn.
POSTGRES_DB=resilience_engine
POSTGRES_USER=resilience
POSTGRES_PASSWORD=change-me
# Optional: Jaeger hosts the workflow component may query (default shown).
# WORKFLOW_JAEGER_ALLOWED_HOSTS=localhost,127.0.0.1,::1,jaeger
