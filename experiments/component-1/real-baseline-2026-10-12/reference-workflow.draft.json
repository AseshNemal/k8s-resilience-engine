  "labelRationale": [
    {
      "edge": {"source": "frontend", "target": "checkoutservice"},
      "proposedLabel": "mandatory",
      "reason": "PlaceOrder failure returns HTTP 500, so the registered HTTP-200 terminal outcome cannot be reached.",
      "source": "https://github.com/GoogleCloudPlatform/microservices-demo/blob/39efed435e697bcdcd31c5e45f4d36dc35c98a63/src/frontend/handlers.go#L354-L374"
    },
    {
      "edge": {"source": "checkoutservice", "target": "cartservice"},
      "proposedLabel": "mandatory",
      "reason": "GetCart failure aborts order preparation. EmptyCart later is best-effort, but the service-level dependency remains required by GetCart.",
      "source": "https://github.com/GoogleCloudPlatform/microservices-demo/blob/39efed435e697bcdcd31c5e45f4d36dc35c98a63/src/checkoutservice/main.go#L285-L333"
    },
    {
      "edge": {"source": "checkoutservice", "target": "productcatalogservice"},
      "proposedLabel": "mandatory",
      "reason": "For the fixed non-empty-cart workload, each item requires GetProduct and failure aborts checkout.",
      "source": "https://github.com/GoogleCloudPlatform/microservices-demo/blob/39efed435e697bcdcd31c5e45f4d36dc35c98a63/src/checkoutservice/main.go#L335-L353"
    },
    {
      "edge": {"source": "checkoutservice", "target": "currencyservice"},
      "proposedLabel": "mandatory",
      "reason": "Item and shipping-price conversion errors abort order preparation. The code uses context.TODO(), which explains why this expected edge is absent from the correlated trace.",
      "source": "https://github.com/GoogleCloudPlatform/microservices-demo/blob/39efed435e697bcdcd31c5e45f4d36dc35c98a63/src/checkoutservice/main.go#L285-L364"
    },
    {
      "edge": {"source": "checkoutservice", "target": "paymentservice"},
      "proposedLabel": "mandatory",
      "reason": "Charge failure returns a gRPC error from PlaceOrder.",
      "source": "https://github.com/GoogleCloudPlatform/microservices-demo/blob/39efed435e697bcdcd31c5e45f4d36dc35c98a63/src/checkoutservice/main.go#L249-L252"
    },
    {
      "edge": {"source": "checkoutservice", "target": "shippingservice"},
      "proposedLabel": "mandatory",
      "reason": "Both quote and shipment errors abort the successful order path.",
      "source": "https://github.com/GoogleCloudPlatform/microservices-demo/blob/39efed435e697bcdcd31c5e45f4d36dc35c98a63/src/checkoutservice/main.go#L300-L319"
    },
    {
      "edge": {"source": "checkoutservice", "target": "emailservice"},
      "proposedLabel": "optional",
      "reason": "SendOrderConfirmation failure is logged and PlaceOrder still returns success.",
      "source": "https://github.com/GoogleCloudPlatform/microservices-demo/blob/39efed435e697bcdcd31c5e45f4d36dc35c98a63/src/checkoutservice/main.go#L270-L276"
    },
    {
      "edge": {"source": "frontend", "target": "currencyservice"},
      "proposedLabel": "mandatory",
      "reason": "The post-order currency-list call returns HTTP 500 on failure before successful page rendering.",
      "source": "https://github.com/GoogleCloudPlatform/microservices-demo/blob/39efed435e697bcdcd31c5e45f4d36dc35c98a63/src/frontend/handlers.go#L378-L394"
    },
    {
      "edge": {"source": "frontend", "target": "recommendationservice"},
      "proposedLabel": "optional",
      "reason": "The recommendation error is explicitly discarded on the order page.",
      "source": "https://github.com/GoogleCloudPlatform/microservices-demo/blob/39efed435e697bcdcd31c5e45f4d36dc35c98a63/src/frontend/handlers.go#L376-L379"
    },
    {
      "edge": {"source": "recommendationservice", "target": "productcatalogservice"},
      "proposedLabel": "optional",
      "reason": "This call supplies recommendations, whose failure is ignored by the order handler.",
      "source": "https://github.com/GoogleCloudPlatform/microservices-demo/blob/39efed435e697bcdcd31c5e45f4d36dc35c98a63/src/recommendationservice/recommendation_server.py#L67-L72"
    },
    {
      "edge": {"source": "frontend", "target": "productcatalogservice"},
      "proposedLabel": "optional",
      "reason": "These calls resolve recommendation details; failure propagates only into the recommendation result that the order handler ignores.",
      "source": "https://github.com/GoogleCloudPlatform/microservices-demo/blob/39efed435e697bcdcd31c5e45f4d36dc35c98a63/src/frontend/rpc.go#L99-L116"
    }
  ],
