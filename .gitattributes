# Auto detect text files and perform LF normalization
* text=auto

# Windows batch files need CRLF line endings.
*.cmd text eol=crlf

# Shell scripts run inside Linux containers: CRLF in the shebang breaks them.
*.sh text eol=lf

# Test fixtures (certificates, keys, kubeconfigs) are compared byte for byte by Python and Go tests.
tests/fixtures/** text eol=lf
